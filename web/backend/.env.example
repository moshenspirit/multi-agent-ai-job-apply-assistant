# ===== 复制为 .env 后填写：cp .env.example .env =====

# ---- LLM（core/agents/llm_client.py 支持 provider 抽象，改 LLM_PROVIDER 即可切换）----
# 可选: deepseek / minimax / ollama
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容端点（切换其它 provider 时填）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ---- Flask ----
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# ---- 数据库（默认 SQLite，位于 backend/data/database.db，首次运行自动建表）----
# DATABASE_URL=sqlite:///data/database.db
